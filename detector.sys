# iTunes Auto-Open + Device Detection + Log

Save as:

`iTunesDeviceMonitor.ps1`

```powershell
# ==========================================================
# iTunes Auto-Open + Apple Device Detection + Logging
# Windows + iTunes 12.x
# ==========================================================

$ErrorActionPreference = "SilentlyContinue"

# -------- LOG LOCATION --------

$LogFolder = "$env:USERPROFILE\Documents\iTunes_Backup_Logs"

if (-not (Test-Path $LogFolder)) {
    New-Item -ItemType Directory -Path $LogFolder -Force | Out-Null
}

$LogFile = Join-Path $LogFolder "iTunes_Device_Log.txt"

# -------- LOG FUNCTION --------

function Write-Log {
    param (
        [string]$Message
    )

    $Time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $Entry = "[$Time] $Message"

    Add-Content -Path $LogFile -Value $Entry

    Write-Host $Entry
}

Write-Log "=========================================="
Write-Log "iTunes Device Monitor started"
Write-Log "=========================================="

# -------- FIND iTUNES --------

$iTunesPaths = @(
    "$env:ProgramFiles\iTunes\iTunes.exe",
    "${env:ProgramFiles(x86)}\iTunes\iTunes.exe"
)

$iTunesPath = $iTunesPaths |
    Where-Object { Test-Path $_ } |
    Select-Object -First 1

if (-not $iTunesPath) {

    Write-Log "ERROR: iTunes.exe was not found."
    Write-Log "Monitor stopped."

    exit
}

Write-Log "iTunes found: $iTunesPath"

# -------- OPEN iTUNES --------

$iTunesProcess = Get-Process "iTunes" -ErrorAction SilentlyContinue

if (-not $iTunesProcess) {

    Write-Log "iTunes is not running."
    Write-Log "Opening iTunes..."

    Start-Process $iTunesPath

    Start-Sleep -Seconds 5

    Write-Log "iTunes opened."

}
else {

    Write-Log "iTunes is already running."
}

Write-Log "Waiting for Apple device..."

# -------- DEVICE MONITOR --------

$LastDevice = ""

while ($true) {

    try {

        $iTunes = New-Object -ComObject iTunes.Application

        $DeviceFound = $false

        foreach ($Source in $iTunes.Sources) {

            # Device source
            if ($Source.Kind -eq 2) {

                $DeviceFound = $true
                $DeviceName = $Source.Name

                # Only log a new detection once
                if ($LastDevice -ne $DeviceName) {

                    Write-Log "APPLE DEVICE DETECTED: $DeviceName"

                    $LastDevice = $DeviceName
                }
            }
        }

        # Device disconnected
        if (-not $DeviceFound) {

            if ($LastDevice -ne "") {

                Write-Log "Apple device disconnected: $LastDevice"

                $LastDevice = ""
            }
        }

    }
    catch {

        if ($LastDevice -ne "iTunesError") {

            Write-Log "Waiting for iTunes connection..."

            $LastDevice = "iTunesError"
        }
    }

    Start-Sleep -Seconds 3
}
```

### Where the log is saved

The script automatically creates:

```text
Documents
└── iTunes_Backup_Logs
    └── iTunes_Device_Log.txt
```

Example:

```text
[2026-08-07 07:45:10] iTunes Device Monitor started
[2026-08-07 07:45:11] iTunes found: C:\Program Files\iTunes\iTunes.exe
[2026-08-07 07:45:11] iTunes is not running.
[2026-08-07 07:45:16] iTunes opened.
[2026-08-07 07:45:16] Waiting for Apple device...
[2026-08-07 07:47:02] APPLE DEVICE DETECTED: My iPhone
[2026-08-07 07:50:21] Apple device disconnected: My iPhone
```

This version **only detects and logs the device**. It does not erase, restore, or automatically sync it.
