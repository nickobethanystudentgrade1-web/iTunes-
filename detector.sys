m# iTunes Apple Device Detector

# Windows + iTunes 12.x

$ErrorActionPreference = "SilentlyContinue"

Write-Host ""
Write-Host "========================================="
Write-Host "       APPLE DEVICE DETECTOR"
Write-Host "========================================="
Write-Host ""
Write-Host "Waiting for an iPhone, iPad, or iPod..."
Write-Host "Press Ctrl+C to stop."
Write-Host ""

$LastStatus = ""

while ($true) {

```
# Check whether iTunes is running
$iTunesProcess = Get-Process "iTunes" -ErrorAction SilentlyContinue

if (-not $iTunesProcess) {

    if ($LastStatus -ne "iTunesClosed") {
        Write-Host "$(Get-Date -Format 'HH:mm:ss') - iTunes is not running."
        $LastStatus = "iTunesClosed"
    }

    Start-Sleep -Seconds 3
    continue
}

try {

    # Connect to iTunes
    $iTunes = New-Object -ComObject iTunes.Application

    # Check connected Apple devices
    $Sources = $iTunes.Sources

    $DeviceFound = $false

    foreach ($Source in $Sources) {

        # iTunes device sources normally have kind = 2
        if ($Source.Kind -eq 2) {

            $DeviceFound = $true
            $DeviceName = $Source.Name

            if ($LastStatus -ne $DeviceName) {

                Write-Host ""
                Write-Host "========================================="
                Write-Host "        APPLE DEVICE DETECTED!"
                Write-Host "========================================="
                Write-Host ""
                Write-Host "Device: $DeviceName" -ForegroundColor Green
                Write-Host "Time:   $(Get-Date)"
                Write-Host ""

                $LastStatus = $DeviceName
            }
        }
    }

    if (-not $DeviceFound) {

        if ($LastStatus -ne "NoDevice") {

            Write-Host "$(Get-Date -Format 'HH:mm:ss') - No Apple device detected."

            $LastStatus = "NoDevice"
        }
    }

}
catch {

    if ($LastStatus -ne "iTunesError") {

        Write-Host "Waiting for iTunes..."
        $LastStatus = "iTunesError"
    }
}

Start-Sleep -Seconds 3
